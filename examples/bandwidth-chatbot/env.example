# Public hostname for the BXML StartStream destination (no scheme, e.g. ngrok subdomain)
PROXY_HOST=

# Optional: change the local port the bot listens on
PORT=7860

# Bandwidth API credentials (OAuth 2.0 client_credentials)
# Required for auto hang-up on EndFrame / CancelFrame.
BANDWIDTH_CLIENT_ID=
BANDWIDTH_CLIENT_SECRET=

# AI service keys
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
